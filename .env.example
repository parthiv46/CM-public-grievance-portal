# Required for signed login sessions on Vercel. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Required MongoDB Atlas or MongoDB server connection.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=cm_kerala_portal

# Optional Gemini AI configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional; defaults to 3000 locally.
PORT=3000
